# Hızlı pilot: 15 sn liste taraması; 180 sn'de bir önceki günle mutabakat.
DATA_DIR=data
POLL_SECONDS=15
POLL_REQUEST_TIMEOUT_SECONDS=8
POLL_RECONCILE_SECONDS=180
REQUEST_TIMEOUT_SECONDS=25
RETENTION_DAYS=90

# Tokenı yalnızca yerel/sunucu ayar dosyasına yazın.
# Özel kanala botu yönetici ekleyin; kanal kimliği -100 ile başlar.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_INTERVAL_SECONDS=1.2

# SmartMail kapalıysa her bildirim için e-posta; açıksa yalnızca kritik eşleşmeler.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Yerel test sonrası etkinleştirilebilir. AI anahtarı gerektirmez.
SMARTMAIL_ENABLED=false
SMARTMAIL_MODE=shadow
SMARTMAIL_DETAILS_ENABLED=true
SMARTMAIL_DETAIL_STREAMS=members
SMARTMAIL_DETAIL_INTERVAL_SECONDS=2
SMARTMAIL_DETAIL_DAILY_LIMIT=2000
SMARTMAIL_RULES_FILE=config/smartmail_rules.json
SMARTMAIL_FINANCIAL_CONTEXT_FILE=
